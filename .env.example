# ===========================================
# Maxqo — environment variables
# Live site: https://www.maxqo.co.uk
# Local: copy to `.env` (never commit real passwords)
# Vercel: Project Settings → Environment Variables
# ===========================================

# --- Nodemailer / SMTP (required on Vercel) ---
# Gmail: use an App Password (Google Account → Security → App passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=developerdesignz123@gmail.com
SMTP_PASS=diph xnvi kbvm iwwx

# Inbox that receives new contact form enquiries
ADMIN_EMAIL=hbahi024@gmail.com

# Optional display name in From header
MAIL_FROM_NAME=Maxqo Website

# Public site URL (used in emails / absolute links)
SITE_URL=https://www.maxqo.co.uk

# --- Local Express API only (optional; not needed on Vercel) ---
PORT=3001

# --- Frontend ---
# Leave EMPTY on Vercel (form posts to https://www.maxqo.co.uk/api/contact)
# VITE_API_URL=

# ===========================================
# Vercel checklist for https://www.maxqo.co.uk
# 1. Domain already connected → www.maxqo.co.uk
# 2. Add SMTP_* + ADMIN_EMAIL + SITE_URL in Vercel env (Production)
# 3. Redeploy after saving env vars
# 4. Test form → https://www.maxqo.co.uk/contact
# 5. Do NOT set VITE_API_URL on Vercel
# ===========================================
